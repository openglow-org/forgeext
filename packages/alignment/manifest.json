{
  "manifest": 1,
  "id": "org.openglow.alignment",
  "name": "Visual alignment",
  "version": "0.1.0",
  "description": "The head camera's view with a crosshair and a jog pad beside it, and the beam moved to where the crosshair was, for LightBurn's Start From: Current Position.",
  "author": "OpenGlow",
  "license": "MIT",
  "homepage": "https://docs.forgefirm.org/usage/alignment/",
  "api": "0.1",
  "runtime": "ui",
  "modes": ["grbl"],
  "capabilities": ["ui", "machine.read", "camera.head", "motion.jog", "settings.own", "motion.job"],
  "settings": {
    "offset_x_mm": { "type": "number", "default": 24.6, "min": -60, "max": 60, "label": "Camera to beam, X (mm)" },
    "offset_y_mm": { "type": "number", "default": 0, "min": -60, "max": 60, "label": "Camera to beam, Y (mm)" },
    "calibrated":  { "type": "bool", "default": false, "label": "Calibrated on this machine" },
    "lamp":        { "type": "number", "default": 60, "min": 0, "max": 1023, "label": "Head light (0 to 1023)" },
    "height_mm":   { "type": "number", "default": 3, "min": 0, "max": 40, "label": "Material height (mm), for the scale" },
    "burn_power":  { "type": "number", "default": 20, "min": 1, "max": 100, "label": "Calibration mark power (%)" },
    "burn_feed":   { "type": "number", "default": 600, "min": 60, "max": 6000, "label": "Calibration mark speed (mm/min)" },
    "jog_feed":    { "type": "number", "default": 3000, "min": 100, "max": 12000, "label": "Jog speed (mm/min)" }
  }
}
