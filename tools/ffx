class Refused(Exception):
    """The host's refusal, in its words."""


def _bytes(s):
    return len(s.encode("utf-8"))


def _is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def _is_number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def id_ok(i):
    if not isinstance(i, str) or not 3 <= len(i) <= 63:
        return False
    label, labels = 0, 1
    for k, c in enumerate(i):
        if c == ".":
            if label == 0 or i[k - 1] == "-":
                return False
            label, labels = 0, labels + 1
        elif "a" <= c <= "z":
            label += 1
        elif (c.isdigit() or c == "-") and label > 0 and c.isascii():
            label += 1
        else:
            return False
        if label > 31:
            return False
    return label > 0 and i[-1] != "-" and labels >= 2


def _number(s, pos):
    m = re.compile(r"[0-9]+").match(s, pos)
    if not m or (m.group()[0] == "0" and len(m.group()) > 1) or len(m.group()) > 9:
        return None, pos
    return int(m.group()), m.end()


def version_split(v):
    if not isinstance(v, str) or _bytes(v) > 32:
        return None
    nums, p = [], 0
    for k in range(3):
        n, p = _number(v, p)
        if n is None:
            return None
        nums.append(n)
        if k < 2:
            if p >= len(v) or v[p] != ".":
                return None
            p += 1
    if p == len(v):
        return nums, None
    if v[p] != "-" or p + 1 == len(v) or not re.fullmatch(r"[A-Za-z0-9.-]+", v[p + 1:]):
        return None
    return nums, v[p + 1:]


def version_ok(v):
    return version_split(v) is not None


def version_cmp(a, b):
    (na, pa), (nb, pb) = version_split(a) or ([0, 0, 0], None), version_split(b) or ([0, 0, 0], None)
    if na != nb:
        return -1 if na < nb else 1
    if pa is None and pb is None:
        return 0
    if pa is None:
        return 1
    if pb is None:
        return -1
    return (pa > pb) - (pa < pb)


def _text(root, key, required, size):
    if key not in root:
        if required:
            raise Refused('"%s" is missing' % key)
        return ""
    s = root[key]
    if not isinstance(s, str):
        raise Refused('"%s" is not a string' % key)
    if "\0" in s:
        raise Refused('"%s" holds a NUL' % key)
    if s == "" and required:
        raise Refused('"%s" is empty' % key)
    if _bytes(s) >= size:
        raise Refused('"%s" is longer than %d bytes' % (key, size - 1))
    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in s):
        raise Refused('"%s" holds a control character' % key)
    return s


def inside_path_ok(p):
    if not p or p[0] == "/":
        return False
    for seg in p.split("/"):
        if seg in ("", ".", ".."):
            return False
    return all(" " < c <= "~" and c != "\\" for c in p)


def _dns_name_ok(h):
    if not 1 <= len(h) <= 253 or h[0] == "." or h[-1] == ".":
        return False
    label = 0
    for k, c in enumerate(h):
        if c == ".":
            if label == 0 or h[k - 1] == "-":
                return False
            label = 0
        elif (c.isascii() and c.isalnum()) or (c == "-" and label > 0):
            label += 1
            if c.isupper() or label > 63:
                return False
        else:
            return False
    return h[-1] != "-"


def _outbound(arg):
    if arg.startswith("["):
        close = arg.find("]")
        if close < 0 or arg[close + 1:close + 2] != ":":
            return None
        host, port = arg[1:close], arg[close + 2:]
        if not (2 <= len(host) <= 45 and ":" in host and re.fullmatch(r"[0-9a-f:.]+", host)):
            return None
    else:
        colon = arg.rfind(":")
        if colon <= 0:
            return None
        host, port = arg[:colon], arg[colon + 1:]
        if not _dns_name_ok(host):
            return None
    if not re.fullmatch(r"[1-9][0-9]{0,8}", port) or not 1 <= int(port) <= 65535:
        return None
    return host, int(port)


def caps_check(cap):
    """caps_check(): None when the capability is one a manifest may ask for, else the words."""
    if not cap or len(cap) >= CAP_MAX_LEN:
        return "a capability is 1 to %d characters" % (CAP_MAX_LEN - 1)
    if any(not (" " < c <= "~") for c in cap):
        return "a capability is printable ASCII with no space"
    arg = cap.split(":", 1)[1] if ":" in cap else None
    if cap == "role" or cap.startswith("role:"):
        if arg in ("homing", "controller"):
            return "role %s is part of the firmware: no package provides it" % arg
        return "no package provides a role in this extension API"
    name = cap.split(":", 1)[0]
    if name not in CAPS:
        return "%s is not a capability" % name
    takes, _grant, offered = CAPS[name]
    if not offered:
        return "%s is not offered by this extension API" % name
    if not takes:
        return "%s takes no argument" % name if arg is not None else None
    if not arg:
        return "%s needs an argument (%s:<value>)" % (name, name)
    if name == "net.outbound":
        hp = _outbound(arg)
        if hp is None:
            return ("net.outbound names one destination, host:port, the host a lowercase DNS name, an IPv4 "
                    "address, or an IPv6 address in brackets")
        if hp[0] == "localhost" or hp[0].startswith("127.") or hp[0] == "::1":
            return "net.outbound never names the machine itself"
        return None
    if name == "net.listen":
        if not re.fullmatch(r"[1-9][0-9]{0,8}", arg) or not 1024 <= int(arg) <= 65535:
            return "net.listen names one port, 1024 to 65535"
        if int(arg) in FIRMWARE_PORTS:
            return "port %d is the firmware's own" % int(arg)
        return None
    if name == "mcode":
        if not re.fullmatch(r"[1-9][0-9]{0,8}", arg) or not MCODE_MIN <= int(arg) <= MCODE_MAX:
            return "mcode names one M-code, %d to %d" % (MCODE_MIN, MCODE_MAX)
        return None
    if name == "storage":
        if not re.fullmatch(r"[1-9][0-9]{0,8}", arg) or not 1 <= int(arg) <= 256:
            return "storage names a quota in MiB, 1 to 256"
        return None
    return "%s is not offered by this extension API" % name


def needs_grant(cap):
    return CAPS.get(cap.split(":", 1)[0], (0, 0, 0))[1]


def _setting(name, o):
    if not re.fullmatch(r"[a-z][a-z0-9_]*", name) or len(name) >= SETTING_NAME_MAX:
        raise Refused('setting "%s": a name is a to z, 0 to 9 and _, starting with a letter, at most %d bytes'
                      % (name[:32], SETTING_NAME_MAX - 1))
    if not isinstance(o, dict):
        raise Refused('setting "%s" is not an object' % name)
    for k in o:
        if k not in ("type", "default", "label", "min", "max", "choices"):
            raise Refused('setting "%s" has an unknown key "%s"' % (name, k[:32]))
    t = o.get("type")
    if t not in ("string", "number", "bool", "choice"):
        raise Refused('setting "%s": "type" is string, number, bool, or choice' % name)
    if "label" in o:
        lb = o["label"]
        if not isinstance(lb, str) or "\0" in lb or _bytes(lb) >= SETTING_LABEL_MAX:
            raise Refused('setting "%s": "label" is a string of at most %d bytes' % (name, SETTING_LABEL_MAX - 1))
    if "default" not in o:
        raise Refused('setting "%s": "default" is missing (a setting is never unset)' % name)
    d, mn, mx = o["default"], o.get("min"), o.get("max")
    if t == "number":
        if not _is_number(d):
            raise Refused('setting "%s": its default is not a number' % name)
        if "min" in o and not _is_number(mn):
            raise Refused('setting "%s": "min" is not a number' % name)
        if "max" in o and not _is_number(mx):
            raise Refused('setting "%s": "max" is not a number' % name)
        if "min" in o and "max" in o and mn > mx:
            raise Refused('setting "%s": its min is above its max' % name)
        if ("min" in o and d < mn) or ("max" in o and d > mx):
            raise Refused('setting "%s": its default is outside its own bounds' % name)
        return
    if "min" in o:
        raise Refused('setting "%s": "min" belongs to a number' % name)
    if t == "bool":
        if "max" in o:
            raise Refused('setting "%s": "max" belongs to a number or a string' % name)
        if not isinstance(d, bool):
            raise Refused('setting "%s": its default is not true or false' % name)
        return
    if not isinstance(d, str) or "\0" in d:
        raise Refused('setting "%s": its default is not a string' % name)
    if t == "choice":
        if "max" in o:
            raise Refused('setting "%s": "max" belongs to a number or a string' % name)
        ch = o.get("choices")
        if not isinstance(ch, list) or not 2 <= len(ch) <= SETTING_CHOICES_MAX:
            raise Refused('setting "%s": a choice has 2 to %d choices' % (name, SETTING_CHOICES_MAX))
        seen = []
        for k, c in enumerate(ch):
            if not isinstance(c, str) or "\0" in c or not c or _bytes(c) >= SETTING_CHOICE_MAX:
                raise Refused('setting "%s": choice %d is not a string of 1 to %d bytes' % (name, k, SETTING_CHOICE_MAX - 1))
            if c in seen:
                raise Refused('setting "%s": the choice "%s" is named twice' % (name, c[:32]))
            seen.append(c)
        if d not in seen:
            raise Refused('setting "%s": its default is not one of its choices' % name)
        return
    if "choices" in o:
        raise Refused('setting "%s": "choices" belongs to a choice' % name)
    top = SETTING_TEXT_MAX - 1
    if "max" in o:
        if not _is_int(mx) or not 1 <= mx <= SETTING_TEXT_MAX - 1:
            raise Refused('setting "%s": "max" is a whole number of bytes, 1 to %d' % (name, SETTING_TEXT_MAX - 1))
        top = mx
    if _bytes(d) > top:
        raise Refused('setting "%s": its default is longer than its own max' % name)


def _no_duplicates(pairs):
    out = {}
    for k, v in pairs:
        if k in out:
            raise Refused("the manifest is not JSON: duplicate object key \"%s\"" % k)
        out[k] = v
    return out


def _no_constant(name):
    raise Refused("the manifest is not JSON: %s is not a JSON value" % name)


def judge_manifest(raw):
    """manifest_parse(): the manifest as a dict, or Refused with the host's words."""
    if len(raw) > MANIFEST_MAX_BYTES:
        raise Refused("the manifest is larger than %d bytes" % MANIFEST_MAX_BYTES)
    try:
        root = json.loads(raw.decode("utf-8"), object_pairs_hook=_no_duplicates, parse_constant=_no_constant)
    except (ValueError, UnicodeDecodeError) as e:
        if isinstance(e, Refused):
            raise
        raise Refused("the manifest is not JSON: %s" % e)
    if not isinstance(root, dict):
        raise Refused("the manifest is not a JSON object")
    for k in root:
        if k not in KNOWN_KEYS:
            raise Refused('unknown key "%s"' % k[:48])
    if not _is_int(root.get("manifest")) or root["manifest"] != 1:
        raise Refused('"manifest" is the schema number, 1')
    pid = _text(root, "id", True, TEXT["id"])
    if not id_ok(pid):
        raise Refused('"id" is a reverse-DNS name in lowercase: two or more labels of a-z, 0-9, and -, each '
                      'starting with a letter, 63 characters in all')
    _text(root, "name", True, TEXT["name"])
    if not version_ok(_text(root, "version", True, TEXT["version"])):
        raise Refused('"version" is MAJOR.MINOR.PATCH with an optional -prerelease')
    _text(root, "description", False, TEXT["description"])
    _text(root, "author", True, TEXT["author"])
    _text(root, "license", True, TEXT["license"])
    _text(root, "homepage", False, TEXT["homepage"])
    api = _text(root, "api", True, 17)
    m = re.fullmatch(r"(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})", api)
    if not m:
        raise Refused('"api" is MAJOR.MINOR, for example "%d.%d"' % API)
    major, minor = int(m.group(1)), int(m.group(2))
    if not (major == API[0] and (minor == API[1] if major == 0 else minor <= API[1])):
        raise Refused("built for extension API %d.%d; this firmware serves %d.%d" % (major, minor, API[0], API[1]))
    if "core" in root:
        core = root["core"]
        if not isinstance(core, dict):
            raise Refused('"core" is not an object')
        for k, v in core.items():
            if k not in ("min", "max"):
                raise Refused('"core" has an unknown key "%s"' % k[:32])
            if not isinstance(v, str) or not version_ok(v):
                raise Refused('"core"."%s" is not a version (MAJOR.MINOR.PATCH)' % k)
        if "min" in core and "max" in core and version_cmp(core["min"], core["max"]) > 0:
            raise Refused('"core"."min" is above "core"."max"')
    runtime = _text(root, "runtime", True, 17)
    if runtime not in RUNTIMES:
        raise Refused('"runtime" is one of data, ui, shell, native, python')
    service = runtime in SERVICE_RUNTIMES
    svc = root.get("service")
    if not service:
        if "service" in root:
            raise Refused('runtime %s runs nothing on the machine: it has no "service"' % runtime)
    else:
        if "service" not in root:
            raise Refused('runtime %s needs a "service"' % runtime)
        if not isinstance(svc, dict):
            raise Refused('"service" is not an object')
        for k in svc:
            if k not in ("exec", "args"):
                raise Refused('"service" has an unknown key "%s"' % k[:32])
        if not inside_path_ok(_text(svc, "exec", True, 193)):
            raise Refused('"service"."exec" is a path inside the package: relative, no "..", no space, forward slashes')
        if "args" in svc:
            args = svc["args"]
            if not isinstance(args, list) or len(args) > MAX_ARGS:
                raise Refused('"service"."args" is an array of at most %d strings' % MAX_ARGS)
            for k, a in enumerate(args):
                if not isinstance(a, str) or "\0" in a or _bytes(a) >= 129:
                    raise Refused('"service"."args"[%d] is not a string of at most 128 bytes' % k)
                if any(ord(c) < 0x20 or ord(c) == 0x7F for c in a):
                    raise Refused('"service"."args"[%d] holds a control character' % k)
    if "modes" in root:
        modes = root["modes"]
        if not isinstance(modes, list) or not modes:
            raise Refused('"modes" is a list of grbl, cloud, or both')
        seen = []
        for s in modes:
            if s not in ("grbl", "cloud") or s in seen:
                raise Refused('"modes" is a list of grbl, cloud, or both, each once')
            seen.append(s)
    if "capabilities" not in root:
        raise Refused('"capabilities" is missing (an empty list asks for nothing)')
    caps = root["capabilities"]
    if not isinstance(caps, list) or len(caps) > MAX_CAPS:
        raise Refused('"capabilities" is an array of at most %d strings' % MAX_CAPS)
    have = []
    for k, c in enumerate(caps):
        if not isinstance(c, str) or "\0" in c:
            raise Refused('"capabilities"[%d] is not a string' % k)
        why = caps_check(c)
        if why:
            raise Refused('capability "%s": %s' % (c[:80], why))
        if c in have:
            raise Refused('capability "%s" is listed twice' % c)
        if runtime == "data":
            raise Refused('runtime data executes nothing and holds no capability ("%s")' % c)
        if not service and c.split(":", 1)[0] in SERVICE_ONLY:
            raise Refused('capability "%s" belongs to a service, and runtime %s has none' % (c, runtime))
        have.append(c)
    if sum(1 for c in have if c.startswith("storage:")) > 1:
        raise Refused('"storage" is asked for twice')
    for c in have:
        if c.startswith("mcode:") and "job_time.run" not in have:
            raise Refused('capability "%s" is answered while a job runs, which takes job_time.run: ask for it too' % c)
    if "conflicts" in root:
        lst = root["conflicts"]
        if not isinstance(lst, list) or len(lst) > MAX_LIST:
            raise Refused('"conflicts" is an array of at most %d package ids' % MAX_LIST)
        seen = []
        for k, i in enumerate(lst):
            if not isinstance(i, str) or not id_ok(i):
                raise Refused('"conflicts"[%d] is not a package id' % k)
            if i == pid:
                raise Refused("a package does not conflict with itself")
            if i in seen:
                raise Refused('"conflicts" lists %s twice' % i)
            seen.append(i)
    if "settings" in root:
        st = root["settings"]
        if not isinstance(st, dict):
            raise Refused('"settings" is an object of named settings')
        if len(st) > MAX_SETTINGS:
            raise Refused('"settings" has at most %d keys' % MAX_SETTINGS)
        for name, o in st.items():
            _setting(name, o)
    return root


def payload_files(d):
    """Every file and directory of the package, as the payload will hold them, or Refused."""
    out, total = [], 0
    for base, dirs, files in os.walk(d):
        dirs.sort()
        for name in sorted(dirs + files):
            full = os.path.join(base, name)
            rel = os.path.relpath(full, d).replace(os.sep, "/")
            if name in ("__pycache__",) or name.endswith(".ffx"):
                continue
            if os.path.islink(full):
                raise Refused("%s is a symbolic link: a payload holds regular files and directories only" % rel)
            if len(rel) > PATH_MAX or rel.count("/") + 1 > DEPTH_MAX or any(not (" " <= c <= "~") or c == "\\" for c in rel):
                raise Refused("%s: a payload path is printable ASCII, at most %d characters and %d directories deep"
                              % (rel, PATH_MAX, DEPTH_MAX))
            if os.path.isfile(full):
                size = os.path.getsize(full)
                if size > FILE_MAX:
                    raise Refused("%s is larger than a file of a payload may be (%d MiB)" % (rel, FILE_MAX >> 20))
                total += size
                out.append((rel, full, False))
            elif os.path.isdir(full):
                out.append((rel, full, True))
            else:
                raise Refused("%s is neither a file nor a directory" % rel)
        dirs[:] = [x for x in dirs if x != "__pycache__"]
    if sum(1 for x in out if not x[2]) > FILES_MAX:
        raise Refused("the payload holds more than %d files" % FILES_MAX)
    if total > PAYLOAD_MAX:
        raise Refused("the payload is larger than %d MiB unpacked" % (PAYLOAD_MAX >> 20))
    return out


def release_modules():
    with open(os.path.join(SDK, "python", "modules.txt"), encoding="utf-8") as f:
        return set(ln.strip() for ln in f if ln.strip() and not ln.startswith("#"))


def python_imports(d, files):
    """(file, line, module) for each import no module of the release image or of the package answers."""
    have = release_modules()
    own = set()
    for rel, _full, isdir in files:
        top = rel.split("/")
        if not isdir and rel.endswith(".py"):
            own.add(top[-1][:-3])
        if isdir:
            own.add(top[-1])
    out = []
    for rel, full, isdir in files:
        if isdir or not rel.endswith(".py"):
            continue
        try:
            tree = ast.parse(open(full, "rb").read(), rel)
        except SyntaxError as e:
            out.append((rel, e.lineno or 0, "(a syntax error: %s)" % e.msg))
            continue
        for node in ast.walk(tree):
            names = []
            if isinstance(node, ast.Import):
                names = [a.name for a in node.names]
            elif isinstance(node, ast.ImportFrom) and not node.level and node.module:
                names = [node.module]
            for n in names:
                top = n.split(".")[0]
                if top not in have and top not in own:
                    out.append((rel, node.lineno, n))
    return out


# What a native service may be: an ARMv7 hard-float binary, static, or linked against the C library alone,
# with no symbol newer than the image's C library.
NATIVE_LIBS = ("libc.so.6", "libm.so.6", "ld-linux-armhf.so.3", "libpthread.so.0", "libdl.so.2", "librt.so.1")
NATIVE_INTERP = "/lib/ld-linux-armhf.so.3"
IMAGE_GLIBC = (2, 39)


def judge_native(path):
    """None when the file is a native service the machine can run, or the words. The host does not read the
    binary; this is the author's tool telling them before the machine's loader would."""
    import struct
    try:
        b = open(path, "rb").read()
    except OSError as e:
        return "%s cannot be read: %s" % (path, e)
    if b[:4] != b"\x7fELF" or len(b) < 52:
        return "the service is not an ELF binary: a native service is built, not a script (see the template)"
    if b[4] != 1 or b[5] != 1 or struct.unpack_from("<H", b, 18)[0] != 40:
        return "the service is not a 32-bit ARM binary: build it with arm-linux-gnueabihf-gcc (see the template)"
    if not struct.unpack_from("<I", b, 36)[0] & 0x400:
        return "the service is not built for hard float: build it with arm-linux-gnueabihf-gcc, not a soft-float toolchain"
    phoff, = struct.unpack_from("<I", b, 28)
    phentsize, phnum = struct.unpack_from("<HH", b, 42)
    loads, dynamic, interp = [], None, None
    for i in range(phnum):
        o = phoff + i * phentsize
        if o + 32 > len(b):
            return "the service's program headers are cut short"
        p_type, p_offset, p_vaddr, _pa, p_filesz = struct.unpack_from("<IIIII", b, o)
        if p_type == 1:
            loads.append((p_vaddr, p_offset, p_filesz))
        elif p_type == 2:
            dynamic = (p_offset, p_filesz)
        elif p_type == 3:
            interp = b[p_offset:p_offset + p_filesz].rstrip(b"\0").decode("latin-1")
    if dynamic is None:
        return None                                     # static: nothing of the image's is asked for
    if interp != NATIVE_INTERP:
        return "the service asks for the loader %s, and the machine's is %s" % (interp, NATIVE_INTERP)

    def at(vaddr):
        for v, off, size in loads:
            if v <= vaddr < v + size:
                return off + vaddr - v
        return None

    tags = []
    for o in range(dynamic[0], dynamic[0] + dynamic[1], 8):
        tag, val = struct.unpack_from("<iI", b, o)
        if tag == 0:
            break
        tags.append((tag, val))
    strtab = at(next((v for t, v in tags if t == 5), 0))
    if strtab is None:
        return "the service's dynamic section names no string table"

    def name(off):
        end = b.index(b"\0", strtab + off)
        return b[strtab + off:end].decode("latin-1")
    needed = [name(v) for t, v in tags if t == 1]
    extra = [n for n in needed if n not in NATIVE_LIBS]
    if extra:
        return ("the service is linked against %s, which the machine does not promise: link it against the C library "
                "alone (%s), or statically" % (", ".join(extra), ", ".join(NATIVE_LIBS[:2])))
    verneed = next((v for t, v in tags if t == 0x6ffffffe), None)
    count = next((v for t, v in tags if t == 0x6fffffff), 0)
    o = at(verneed) if verneed is not None else None
    newest = (0, 0)
    for _ in range(count if o is not None else 0):
        _ver, cnt, _file, aux, nxt = struct.unpack_from("<HHIII", b, o)
        a = o + aux
        for _k in range(cnt):
            _h, _fl, _other, vname, anext = struct.unpack_from("<IHHII", b, a)
            v = name(vname)
            if v.startswith("GLIBC_") and v[6:7].isdigit():
                try:
                    newest = max(newest, tuple(int(x) for x in v[6:].split(".")[:2]))
                except ValueError:
                    pass
            if not anext:
                break
            a += anext
        if not nxt:
            break
        o += nxt
    if newest > IMAGE_GLIBC:
        return ("the service needs the C library %d.%d, and the machine carries %d.%d: build it with an older "
                "toolchain, or statically" % (newest + IMAGE_GLIBC))
    return None


def lint(d, quiet=False):
    """The package in d judged as the host judges it. (manifest, [warnings]); Refused at the first fault."""
    mpath = os.path.join(d, "manifest.json")
    if not os.path.isfile(mpath):
        raise Refused("the package has no manifest.json")
    m = judge_manifest(open(mpath, "rb").read())
    repo = [n for n in REPO_FILES if os.path.exists(os.path.join(d, n))]
    files = payload_files(d)
    rels = {r for r, _f, isdir in files if not isdir}
    wants_ui = "ui" in m["capabilities"]
    if wants_ui and UI_FILE not in rels:
        raise Refused("this package asks for ui and has no %s" % UI_FILE)
    if not wants_ui and UI_FILE in rels:
        raise Refused("this package has a %s and does not ask for ui" % UI_FILE)
    warnings = []
    if wants_ui:
        size = os.path.getsize(os.path.join(d, UI_FILE))
        if size > UI_MAX:
            raise Refused("%s is %d bytes and at most %d are taken" % (UI_FILE, size, UI_MAX))
        if size == 0:
            raise Refused("%s is empty" % UI_FILE)
        page = open(os.path.join(d, UI_FILE), "rb").read()
        if b"\0" in page:
            raise Refused("%s holds a NUL" % UI_FILE)
        bridge = open(os.path.join(SDK, "js", "ffx-bridge.js"), "rb").read().replace(b"\r\n", b"\n")
        if b"var ffx = (function" in page and bridge not in page.replace(b"\r\n", b"\n"):
            warnings.append("%s carries a bridge client that is not the SDK's %s" % (UI_FILE, "sdk/js/ffx-bridge.js"))
    if m["runtime"] in SERVICE_RUNTIMES:
        ex = m["service"]["exec"]
        if ex not in rels:
            raise Refused("the service's entry point, %s, is not a file of the package" % ex)
        if m["runtime"] == "native":
            why = judge_native(os.path.join(d, ex))
            if why:
                raise Refused(why)
    if m["runtime"] == "python":
        for rel, line, mod in python_imports(d, files):
            raise Refused("%s:%d imports %s, which is not in the release image's module list (sdk/python/modules.txt)"
                          % (rel, line, mod))
    for c in m["capabilities"]:
        if needs_grant(c):
            warnings.append("%s takes the operator's own grant at install" % c)
    if repo:
        warnings.append("%s holds %s: that is the package's repository, not the package as it ships. "
                        "make stage lays that out in build/pkg; lint and pack build/pkg" % (d, ", ".join(repo)))
    if m["id"].startswith(("org.openglow.", "org.forgefirm.")):
        warnings.append("%s is in the official namespace: only an archive signed with the OpenGlow extension key "
                        "installs under it" % m["id"])
    return m, warnings, files


# ---------------------------------------------------------------- pack

def fwup_bin():
    b = os.environ.get("FWUP") or shutil.which("fwup")
    if not b:
        raise Refused("fwup is not found: install it, or set FWUP to its path")
    return b


def payload(d, m, files, out):
    """A gzip-compressed tar of the package, the same bytes every time: sorted names, owner 0, time 0, and
    each file 0644 or 0755 (0755 for the service's entry point and for what is executable here)."""
    ex = (m.get("service") or {}).get("exec")
    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode="w", format=tarfile.GNU_FORMAT) as t:
        for rel, full, isdir in sorted(files):
            info = tarfile.TarInfo(rel)
            info.uid = info.gid = 0
            info.uname = info.gname = "root"
            info.mtime = 0
            if isdir:
                info.type, info.mode = tarfile.DIRTYPE, 0o755
                t.addfile(info)
                continue
            data = open(full, "rb").read()
            info.size = len(data)
            info.mode = 0o755 if rel == ex or (os.name != "nt" and os.stat(full).st_mode & 0o111) else 0o644
            t.addfile(info, io.BytesIO(data))
    with open(out, "wb") as f:
        with gzip.GzipFile(fileobj=f, mode="wb", compresslevel=9, mtime=0, filename="") as gz:
            gz.write(raw.getvalue())


def cmd_pack(a):
    m, warnings, files = lint(a.dir)
    for w in warnings:
        print("note: " + w)
    fwup = fwup_bin()
    out = a.out or "%s-%s.ffx" % (m["id"], m["version"])
    work = tempfile.mkdtemp(prefix="ffx-pack-")
    try:
        pl = os.path.join(work, "payload.tar.gz")
        payload(a.dir, m, files, pl)
        conf = os.path.join(work, "fwup.conf")
        with open(conf, "w") as f:
            f.write('meta-product = "%s"\nmeta-description = "%s"\nmeta-version = "%s"\nmeta-platform = "forgefirm-ext"\n'
                    'file-resource payload.tar.gz {\n    host-path = "%s"\n}\n'
                    % (PRODUCT, m["id"], m["version"], pl.replace("\\", "/")))
        raw = os.path.join(work, "unsigned.ffx")
        subprocess.run([fwup, "-c", "-f", conf, "-o", raw], check=True, capture_output=True)
        if a.key:
            pub = a.key[:-5] + ".pub" if a.key.endswith(".priv") else None
            if not pub or not os.path.isfile(pub):
                raise Refused("the key's public half (%s) is not beside it: a signature that cannot be checked is "
                              "not made" % (pub or a.key + ".pub"))
            signed = os.path.join(work, "signed.ffx")
            subprocess.run([fwup, "-S", "-s", a.key, "-i", raw, "-o", signed], check=True, capture_output=True)
            v = subprocess.run([fwup, "-V", "-i", signed, "-p", pub], capture_output=True)
            if v.returncode != 0:
                raise Refused("the signature does not check against %s" % pub)
            shutil.copyfile(signed, out)
            print("signed: %s (%s %s)" % (out, m["id"], m["version"]))
        else:
            shutil.copyfile(raw, out)
            print("UNSIGNED: %s (%s %s) - a machine installs it only with its button held" % (out, m["id"], m["version"]))
    except subprocess.CalledProcessError as e:
        raise Refused("fwup failed: %s" % (e.stderr or b"").decode("utf-8", "replace").strip())
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return 0


# ---------------------------------------------------------------- the index
# OpenGlow's own tools for the catalog. A catalog is a directory:
#
#   packages/<id>/key.pub          the author's public key (none for an id in OpenGlow's namespace)
#   packages/<id>/<version>.json   one listed version, as `ffx index record` wrote it
#   packages/<id>/withdrawn.json   {"reason": "..."} withdraws the package whole, or
#                                  {"versions": {"<version>": "<reason>", ...}} those versions of it
#
# `index record` verifies one archive and writes its record; `index build` makes the index every machine keeps
# from the directory. index_check() below mirrors forgeext's (src/index.c), and tests/ffx_test.py holds the two
# to agreeing.

INDEX_PRODUCT = "ForgeFIRM extension index"
INDEX_SCHEMA = 1
INDEX_MAX_PKGS, INDEX_MAX_VERSIONS, INDEX_MAX_WITHDRAWN, INDEX_MAX_CAPS = 512, 16, 64, 64
INDEX_MAX_BYTES = 1024 * 1024
ARCHIVE_MAX = 32 << 20
OFFICIAL_NS = ("org.openglow.", "org.forgefirm.")
RECORD_KEYS = ("id", "version", "name", "author", "description", "license", "homepage", "api", "capabilities",
               "core", "url", "sha256", "size")


def archive_manifest(path):
    """The manifest inside an .ffx: its payload's manifest.json, read out of the archive as it is."""
    import zipfile
    try:
        with zipfile.ZipFile(path) as z:
            data = z.read("data/payload.tar.gz")
    except (OSError, KeyError, zipfile.BadZipFile) as e:
        raise Refused("%s is not an extension archive: %s" % (path, e))
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as t:
        # mkffx.sh writes the members as ./path, a packer by hand may not.
        info = next((i for i in t.getmembers() if i.isfile() and i.name in ("manifest.json", "./manifest.json")), None)
        f = t.extractfile(info) if info else None
        if f is None:
            raise Refused("%s holds no manifest.json" % path)
        return judge_manifest(f.read())


def _archive_meta(path):
    """The meta-* lines of an archive's meta.conf, as {name: value}."""
    import zipfile
    try:
        with zipfile.ZipFile(path) as z:
            conf = z.read("meta.conf").decode("utf-8", "replace")
    except (OSError, KeyError, zipfile.BadZipFile) as e:
        raise Refused("%s is not an extension archive: %s" % (path, e))
    out = {}
    for ln in conf.splitlines():
        # fwup quotes a value only when it has to: meta-product="ForgeFIRM extension", meta-version=1.0.0
        m = re.match(r'\s*(meta-[a-z-]+)\s*=\s*(?:"(.*)"|(\S*))\s*$', ln)
        if m:
            out[m.group(1)] = m.group(2) if m.group(2) is not None else m.group(3)
    return out


def _unpack_payload(path, d):
    """The archive's payload unpacked into d, regular files and directories only, nothing outside d."""
    import zipfile
    with zipfile.ZipFile(path) as z:
        data = z.read("data/payload.tar.gz")
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as t:
        for info in t.getmembers():
            rel = info.name[2:] if info.name.startswith("./") else info.name
            if rel in ("", "."):
                continue
            if rel.startswith("/") or ".." in rel.split("/") or not (info.isfile() or info.isdir()):
                raise Refused("%s: the payload holds %s, which no package may" % (path, info.name))
            full = os.path.join(d, *rel.split("/"))
            if info.isdir():
                os.makedirs(full, exist_ok=True)
                continue
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, "wb") as f:
                f.write(t.extractfile(info).read())
            os.chmod(full, 0o755 if info.mode & 0o111 else 0o644)


def _https_ok(u, most):
    if not isinstance(u, str) or not u.startswith("https://") or _bytes(u) > most or len(u) == 8:
        return False
    if any(b <= 0x20 or b == 0x7F for b in u.encode("utf-8")):
        return False
    rest = u[8:]
    ends = [i for i in (rest.find("/"), rest.find("?"), rest.find("#")) if i >= 0]
    at = rest.find("@")
    return at < 0 or (bool(ends) and at > min(ends))        # no user or password in the authority


def _index_text_ok(o, key, required, most):
    if key not in o:
        return not required
    s = o[key]
    if not isinstance(s, str) or _bytes(s) > most or (required and not s):
        return False
    return not any(ord(c) < 0x20 or ord(c) == 0x7F for c in s)


def _index_key_ok(o, id_):
    k = o.get("key")
    if id_.startswith(OFFICIAL_NS) and "key" in o:
        raise Refused("%s is in OpenGlow's namespace: only the OpenGlow extension key signs it, and the index "
                      "endorses no key for it" % id_)
    if not id_.startswith(OFFICIAL_NS) and (not isinstance(k, str) or not 40 <= _bytes(k) <= 64 or "\n" in k):
        raise Refused("%s: the index names its author's public key, as fwup writes it" % id_)


def _cap_form_ok(c):
    return isinstance(c, str) and 1 <= _bytes(c) <= 255 and all(0x21 <= b <= 0x7E for b in c.encode("utf-8"))


def _index_version_check(v, id_):
    ver = v.get("version") if isinstance(v, dict) else None
    if not isinstance(v, dict) or not isinstance(ver, str) or not version_ok(ver):
        raise Refused("%s: a listed version is not one" % id_)
    if not _https_ok(v.get("url"), 1024):
        raise Refused("%s %s: it is fetched from an https:// address, with no user or password in it" % (id_, ver))
    sha = v.get("sha256")
    if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha):
        raise Refused("%s %s: its sha256 is 64 lowercase hex digits" % (id_, ver))
    if not _is_int(v.get("size")) or v["size"] < 1:
        raise Refused("%s %s: its size is a whole number of bytes" % (id_, ver))
    if "capabilities" in v:
        caps = v["capabilities"]
        if not isinstance(caps, list) or len(caps) > INDEX_MAX_CAPS:
            raise Refused("%s %s: its capabilities are a list of at most %d" % (id_, ver, INDEX_MAX_CAPS))
        if not all(_cap_form_ok(c) for c in caps):
            raise Refused("%s %s: a capability is printable text with no space" % (id_, ver))
    if not _index_text_ok(v, "api", False, 16):
        raise Refused("%s %s: its api is MAJOR.MINOR" % (id_, ver))
    if "core" in v:
        core = v["core"]
        if (not isinstance(core, dict) or ("min" in core and not version_ok(core["min"]))
                or ("max" in core and not version_ok(core["max"]))):
            raise Refused('%s %s: its core range is {"min", "max"}, each a version' % (id_, ver))
        if "min" in core and "max" in core and version_cmp(core["min"], core["max"]) > 0:
            raise Refused("%s %s: its core range's min is above its max" % (id_, ver))


def _strings_of(lst, field):
    return [e.get(field) for e in lst if isinstance(e, dict) and isinstance(e.get(field), str)]


def _index_package_check(pkgs, i):
    p = pkgs[i]
    id_ = p.get("id") if isinstance(p, dict) else None
    if not isinstance(p, dict) or not isinstance(id_, str) or not id_ok(id_):
        raise Refused("entry %d of the index has no package id" % (i + 1))
    if id_ in _strings_of(pkgs[:i], "id"):
        raise Refused("the index lists %s twice" % id_)
    if (not _index_text_ok(p, "name", True, 64) or not _index_text_ok(p, "description", False, 256)
            or not _index_text_ok(p, "author", True, 128) or not _index_text_ok(p, "license", False, 64)):
        raise Refused("%s: its name, author, description, or license is not text of its size" % id_)
    if "homepage" in p and not _https_ok(p["homepage"], 256):
        raise Refused("%s: its homepage is an https:// address" % id_)
    _index_key_ok(p, id_)
    vers = p.get("versions")
    if not isinstance(vers, list) or not 1 <= len(vers) <= INDEX_MAX_VERSIONS:
        raise Refused("%s: its versions are a list of 1 to %d" % (id_, INDEX_MAX_VERSIONS))
    for k, v in enumerate(vers):
        _index_version_check(v, id_)
        if v["version"] in _strings_of(vers[:k], "version"):
            raise Refused("the index lists %s %s twice" % (id_, v["version"]))
    if "withdrawn" in p:
        gone = p["withdrawn"]
        if not isinstance(gone, list) or len(gone) > INDEX_MAX_WITHDRAWN:
            raise Refused("%s: its withdrawn versions are a list of at most %d" % (id_, INDEX_MAX_WITHDRAWN))
        for k, w in enumerate(gone):
            ver = w.get("version") if isinstance(w, dict) else None
            if not isinstance(w, dict) or not isinstance(ver, str) or not version_ok(ver) \
                    or not _index_text_ok(w, "reason", False, 256):
                raise Refused('%s: a withdrawn version is {"version", "reason"}' % id_)
            if ver in _strings_of(gone[:k], "version"):
                raise Refused("the index withdraws %s %s twice" % (id_, ver))
            if ver in _strings_of(vers, "version"):
                raise Refused("the index both lists and withdraws %s %s" % (id_, ver))


def index_check(doc):
    """forgeext's index_check(): the form every machine keeps an index in, or Refused in its words."""
    if not isinstance(doc, dict) or not _is_int(doc.get("index")) or doc["index"] != INDEX_SCHEMA:
        raise Refused('an index is {"index": %d, "packages": [...]}' % INDEX_SCHEMA)
    pkgs = doc.get("packages")
    if not isinstance(pkgs, list) or len(pkgs) > INDEX_MAX_PKGS:
        raise Refused("the index's packages are a list of at most %d" % INDEX_MAX_PKGS)
    for i in range(len(pkgs)):
        _index_package_check(pkgs, i)
    if "withdrawn" in doc:
        gone = doc["withdrawn"]
        if not isinstance(gone, list) or len(gone) > INDEX_MAX_PKGS:
            raise Refused("the index's withdrawn packages are a list of at most %d" % INDEX_MAX_PKGS)
        for i, w in enumerate(gone):
            id_ = w.get("id") if isinstance(w, dict) else None
            if not isinstance(w, dict) or not isinstance(id_, str) or not id_ok(id_) \
                    or not _index_text_ok(w, "reason", False, 256):
                raise Refused('withdrawn package %d of the index is {"id", "key", "reason"}' % (i + 1))
            _index_key_ok(w, id_)
            if id_ in _strings_of(gone[:i], "id"):
                raise Refused("the index withdraws %s twice" % id_)
            if id_ in _strings_of(pkgs, "id"):
                raise Refused("the index both lists and withdraws %s" % id_)


def cmd_index_record(a):
    """One listed version, from its signed archive: verified against its signer's key, linted as the machine
    judges it, and written as the record `index build` lists."""
    if not _https_ok(a.url, 1024):
        raise Refused("the archive is fetched from an https:// address, with no user or password in it")
    data = open(a.file, "rb").read()
    if len(data) > ARCHIVE_MAX:
        raise Refused("the archive is larger than a machine takes (%d MiB)" % (ARCHIVE_MAX >> 20))
    meta = _archive_meta(a.file)
    if meta.get("meta-product") != PRODUCT:
        raise Refused("%s is not an extension package: its product is %r" % (a.file, meta.get("meta-product")))
    m = archive_manifest(a.file)
    if meta.get("meta-version") != m["version"]:
        raise Refused("the archive says version %s and its manifest says %s" % (meta.get("meta-version"), m["version"]))
    official = m["id"].startswith(OFFICIAL_NS)
    if official and a.key:
        raise Refused("%s is in OpenGlow's namespace: the index endorses no author key for it" % m["id"])
    pub = a.official_key if official else a.key
    if not pub:
        raise Refused("%s is in OpenGlow's namespace: its signature is checked against the OpenGlow extension key "
                      "(--official-key)" % m["id"] if official else
                      "%s: its signature is checked against its author's public key (--key)" % m["id"])
    v = subprocess.run([fwup_bin(), "-V", "-i", a.file, "-p", pub], capture_output=True)
    if v.returncode != 0:
        raise Refused("%s is not signed with %s" % (a.file, pub))
    work = tempfile.mkdtemp(prefix="ffx-record-")
    try:
        _unpack_payload(a.file, work)
        lint(work, quiet=True)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    rec = {"id": m["id"], "version": m["version"], "name": m["name"], "author": m["author"], "api": m["api"],
           "capabilities": list(m.get("capabilities") or []), "url": a.url,
           "sha256": hashlib.sha256(data).hexdigest(), "size": len(data)}
    for k in ("description", "license", "homepage", "core"):
        if m.get(k):
            rec[k] = m[k]
    text = json.dumps(rec, indent=1, sort_keys=True, ensure_ascii=False) + "\n"
    if a.out:
        with open(a.out, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        print("%s: %s %s" % (a.out, m["id"], m["version"]))
    else:
        sys.stdout.write(text)
    return 0


def _newest_first(vs):
    return sorted(vs, key=functools.cmp_to_key(lambda x, y: version_cmp(y, x)))


def catalog_doc(d):
    """The catalog directory d, read and checked: index.json as every machine keeps it."""
    pdir = os.path.join(d, "packages")
    if not os.path.isdir(pdir):
        raise Refused("%s has no packages/ directory" % d)
    pkgs, gone = [], []
    for id_ in sorted(n for n in os.listdir(pdir) if not n.startswith(".")):     # .gitkeep keeps an empty catalog
        base = os.path.join(pdir, id_)
        if not os.path.isdir(base) or not id_ok(id_):
            raise Refused("packages/%s is not a package's directory, named for its id" % id_)
        official = id_.startswith(OFFICIAL_NS)
        names = sorted(os.listdir(base))
        key = None
        if "key.pub" in names:
            if official:
                raise Refused("packages/%s is in OpenGlow's namespace: it names no key" % id_)
            key = open(os.path.join(base, "key.pub"), encoding="ascii").read().strip()
        elif not official:
            raise Refused("packages/%s: its author's key.pub is missing" % id_)
        w = {}
        if "withdrawn.json" in names:
            w = json.load(open(os.path.join(base, "withdrawn.json"), encoding="utf-8"))
            ok = isinstance(w, dict) and not set(w) - {"reason", "versions"} and ("reason" in w) != ("versions" in w)
            ok = ok and ("reason" not in w or (isinstance(w["reason"], str) and w["reason"].strip()))
            ok = ok and ("versions" not in w or (isinstance(w["versions"], dict) and w["versions"] and all(
                version_ok(k) and isinstance(r, str) and r.strip() for k, r in w["versions"].items())))
            if not ok:
                raise Refused('packages/%s/withdrawn.json is {"reason": "why"} for the whole package, or '
                              '{"versions": {"<version>": "why", ...}}' % id_)
        records = {}
        for n in names:
            if n in ("key.pub", "withdrawn.json"):
                continue
            if not n.endswith(".json") or not version_ok(n[:-5]):
                raise Refused("packages/%s/%s is not a version's record (<version>.json)" % (id_, n))
            rec = json.load(open(os.path.join(base, n), encoding="utf-8"))
            if not isinstance(rec, dict) or rec.get("id") != id_ or rec.get("version") != n[:-5]:
                raise Refused("packages/%s/%s is not the record of %s %s" % (id_, n, id_, n[:-5]))
            extra = sorted(set(rec) - set(RECORD_KEYS))
            if extra:
                raise Refused("packages/%s/%s holds what a record does not: %s" % (id_, n, ", ".join(extra)))
            records[rec["version"]] = rec
        order = _newest_first(list(records))
        if "reason" in w:
            if records:
                raise Refused("packages/%s is withdrawn whole and still lists %s" % (id_, ", ".join(order)))
            e = {"id": id_, "reason": w["reason"]}
            if key:
                e["key"] = key
            gone.append(e)
            continue
        if not records:
            raise Refused("packages/%s lists no version, and is not withdrawn" % id_)
        top = records[order[0]]
        entry = {"id": id_, "name": top.get("name"), "author": top.get("author"), "versions": []}
        for k in ("description", "license", "homepage"):
            if top.get(k):
                entry[k] = top[k]
        if key:
            entry["key"] = key
        for ver in order:
            r = records[ver]
            v = {k: r.get(k) for k in ("version", "url", "sha256", "size")}
            v["capabilities"] = list(r.get("capabilities") or [])
            for k in ("api", "core"):
                if r.get(k):
                    v[k] = r[k]
            entry["versions"].append(v)
        wv = w.get("versions") or {}
        if wv:
            entry["withdrawn"] = [{"version": ver, "reason": wv[ver]} for ver in _newest_first(list(wv))]
        pkgs.append(entry)
    doc = {"index": INDEX_SCHEMA, "packages": pkgs}
    if gone:
        doc["withdrawn"] = gone
    index_check(doc)
    return doc


def cmd_index_build(a):
    """The signed index of a catalog directory, the same bytes for the same catalog every time."""
    if not version_ok(a.version):
        raise Refused("the index's version is MAJOR.MINOR.PATCH, as YYYY.MMDD.N")
    doc = catalog_doc(a.catalog)
    text = (json.dumps(doc, indent=1, sort_keys=True) + "\n").encode()
    if len(text) > INDEX_MAX_BYTES:
        raise Refused("index.json is %d bytes, more than a machine keeps (%d)" % (len(text), INDEX_MAX_BYTES))
    fwup = fwup_bin()
    work = tempfile.mkdtemp(prefix="ffx-index-")
    try:
        raw = io.BytesIO()
        with tarfile.open(fileobj=raw, mode="w", format=tarfile.GNU_FORMAT) as t:
            info = tarfile.TarInfo("index.json")
            info.size, info.mode, info.mtime, info.uname, info.gname = len(text), 0o644, 0, "root", "root"
            t.addfile(info, io.BytesIO(text))
        pl = os.path.join(work, "payload.tar.gz")
        with open(pl, "wb") as f:
            with gzip.GzipFile(fileobj=f, mode="wb", compresslevel=9, mtime=0, filename="") as gz:
                gz.write(raw.getvalue())
        conf = os.path.join(work, "fwup.conf")
        with open(conf, "w") as f:
            f.write('meta-product = "%s"\nmeta-description = "the listed packages"\nmeta-version = "%s"\n'
                    'meta-platform = "forgefirm-ext"\nfile-resource payload.tar.gz {\n    host-path = "%s"\n}\n'
                    % (INDEX_PRODUCT, a.version, pl.replace("\\", "/")))
        unsigned = os.path.join(work, "index.ffi")
        subprocess.run([fwup, "-c", "-f", conf, "-o", unsigned], check=True, capture_output=True)
        if a.key:
            signed = os.path.join(work, "signed.ffi")
            subprocess.run([fwup, "-S", "-s", a.key, "-i", unsigned, "-o", signed], check=True, capture_output=True)
            shutil.copyfile(signed, a.out)
        else:
            shutil.copyfile(unsigned, a.out)
        nver = sum(len(p["versions"]) for p in doc["packages"])
        print("%s: %d package%s, %d version%s, %d withdrawn whole, version %s, index.json sha256 %s%s"
              % (a.out, len(doc["packages"]), "" if len(doc["packages"]) == 1 else "s", nver, "" if nver == 1 else "s",
                 len(doc.get("withdrawn", [])), a.version, hashlib.sha256(text).hexdigest(),
                 "" if a.key else " (UNSIGNED: no machine keeps it)"))
    except subprocess.CalledProcessError as e:
        raise Refused("fwup failed: %s" % (e.stderr or b"").decode("utf-8", "replace").strip())
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return 0


def cmd_keygen(a):
    fwup = fwup_bin()
    for ext in (".pub", ".priv"):
        if os.path.exists(a.name + ext):
            raise Refused("%s%s is already there: a key is never overwritten" % (a.name, ext))
    subprocess.run([fwup, "-g", "-o", a.name], check=True, capture_output=True)
    print("%s.priv  the private key: keep it, and keep it to yourself" % a.name)
    print("%s.pub   the public key: what an owner adds on their machine to trust your packages" % a.name)
    return 0


# ---------------------------------------------------------------- new

REPO_FILES = (".github", ".git", "Makefile", "key.pub")     # a package's repository, not the package as it ships


def cmd_new(a):
    """A package's repository: the package as the runtime's template has it, with the kit's client for its
    runtime, and the repository's own files around it - a Makefile whose stage target lays out what ships in
    build/pkg, the call to forgeext's shared workflow, .gitignore, a README, and key.pub when --key names one."""
    if not id_ok(a.id):
        raise Refused('"%s" is not a package id: two or more lowercase labels, like org.example.notify' % a.id)
    src = os.path.join(TEMPLATE, a.runtime)
    if not os.path.isdir(src):
        raise Refused("no template for runtime %s" % a.runtime)
    # A directory that holds nothing but a clone's .git is where a new repository's package goes.
    if os.path.exists(a.dir) and (not os.path.isdir(a.dir) or set(os.listdir(a.dir)) - {".git"}):
        raise Refused("%s is already there" % a.dir)
    if a.key and not os.path.isfile(a.key):
        raise Refused("%s is not a file: the public key, NAME.pub from ffx keygen" % a.key)
    name = a.name or a.id.rsplit(".", 1)[-1].replace("-", " ").capitalize()
    bridge = open(os.path.join(SDK, "js", "ffx-bridge.js"), encoding="utf-8").read()
    native = a.runtime == "native"
    repo = os.path.join(TEMPLATE, "repo")
    subst = {"@@ID@@": a.id, "@@NAME@@": name, "@@RUNTIME@@": a.runtime, "/* @@FFX_BRIDGE@@ */": bridge,
             "@@BUILD@@": ("\n" + open(os.path.join(repo, "Makefile.native"), encoding="utf-8").read()) if native else "",
             "@@STAGE_NEEDS@@": " bin/run" if native else "", "@@CLEAN@@": " bin" if native else "",
             "@@WITH@@": "    with:\n      apt: gcc-arm-linux-gnueabihf\n" if native else "",
             "@@IGNORE@@": "bin/\n" if native else ""}

    def put(rel, text):
        for k, v in subst.items():
            text = text.replace(k, v)
        out = os.path.join(a.dir, rel)
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(out, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        return out

    os.makedirs(a.dir, exist_ok=True)
    for base, _dirs, files in os.walk(src):
        for fn in files:
            full = os.path.join(base, fn)
            rel = os.path.relpath(full, src)
            try:
                text = open(full, encoding="utf-8").read()
            except UnicodeDecodeError:
                os.makedirs(os.path.dirname(os.path.join(a.dir, rel)), exist_ok=True)
                shutil.copyfile(full, os.path.join(a.dir, rel))
                continue
            out = put(rel, text)
            if os.stat(full).st_mode & 0o111:
                os.chmod(out, 0o755)
    kit = {"python": ("python/ffx.py", "lib/ffx.py"), "shell": ("sh/ffx.sh", "lib/ffx.sh"), "native": ("c/ffx.h", "src/ffx.h")}
    if a.runtime in kit:
        src_rel, dst_rel = kit[a.runtime]
        os.makedirs(os.path.join(a.dir, os.path.dirname(dst_rel)), exist_ok=True)
        shutil.copyfile(os.path.join(SDK, src_rel), os.path.join(a.dir, dst_rel))
    for tpl, rel in (("Makefile", "Makefile"), ("package.yml", os.path.join(".github", "workflows", "package.yml")),
                     ("gitignore", ".gitignore"), ("README.md", "README.md")):
        put(rel, open(os.path.join(repo, tpl), encoding="utf-8").read())
    if a.key:
        shutil.copyfile(a.key, os.path.join(a.dir, "key.pub"))
    print("%s: a %s package, %s, and its repository's files." % (a.dir, a.runtime, a.id))
    print("Next: make -C %s lint%s" % (a.dir, " (it builds bin/run first)" if native else ""))
    if not a.key:
        print("No key.pub yet: ffx keygen NAME, then copy NAME.pub to %s. NAME.priv's text is the "
              "EXTENSION_SIGNING_KEY secret that signs a release." % os.path.join(a.dir, "key.pub"))
    return 0


def cmd_lint(a):
    m, warnings, files = lint(a.dir)
    for w in warnings:
        print("note: " + w)
    print("ok: %s %s, runtime %s, %d files, capabilities: %s" % (m["id"], m["version"], m["runtime"],
          sum(1 for f in files if not f[2]), ", ".join(m["capabilities"]) or "none"))
    return 0


# ---------------------------------------------------------------- a machine

class Machine:
    """A machine's panel over HTTPS, logged in as its owner. Its certificate is its own, made on the machine,
    so it is trusted on first use: the fingerprint is shown once and remembered."""

    def __init__(self, addr, user):
        self.host, _, port = addr.partition(":")
        self.port = int(port or 443)
        if not re.fullmatch(r"[0-9.]+|\[?[0-9a-fA-F:]+\]?", self.host):
            raise Refused("the machine is an address, as the panel's own Host must be: %s" % self.host)
        self.cx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        self.cx.check_hostname = False
        self.cx.verify_mode = ssl.CERT_NONE
        self._pin()
        self.cookie = None
        self.token = None
        self._login(user)

    def _conn(self):
        return http.client.HTTPSConnection(self.host.strip("[]"), self.port, timeout=60, context=self.cx)

    def _pin(self):
        c = self._conn()
        c.connect()
        der = c.sock.getpeercert(binary_form=True)
        c.close()
        fp = hashlib.sha256(der).hexdigest()
        known = os.path.join(os.path.expanduser("~"), ".ffx", "machines.json")
        seen = {}
        try:
            seen = json.load(open(known))
        except (OSError, ValueError):
            pass
        key = "%s:%d" % (self.host, self.port)
        if key in seen and seen[key] != fp:
            raise Refused("%s presents a certificate that is not the one it presented before (%s, now %s). Compare "
                          "it with the fingerprint on the panel's System tab before you trust it again, then remove "
                          "its line from %s" % (key, seen[key][:16], fp[:16], known))
        if key not in seen:
            print("%s presents the certificate %s" % (key, ":".join(fp[i:i + 2] for i in range(0, 64, 2))))
            print("The panel's System tab shows the machine's own. Is it the same?", end=" ")
            if input("[y/N] ").strip().lower() != "y":
                raise Refused("not trusted")
            seen[key] = fp
            os.makedirs(os.path.dirname(known), exist_ok=True)
            json.dump(seen, open(known, "w"), indent=1)

    def request(self, method, path, body=None, ctype=None, token=True):
        hdrs = {"Host": "%s:%d" % (self.host, self.port) if self.port != 443 else self.host}
        if ctype:
            hdrs["Content-Type"] = ctype
        if self.cookie:
            hdrs["Cookie"] = self.cookie
        if token and self.token:
            hdrs["X-ForgeFIRM-Token"] = self.token
        c = self._conn()
        try:
            c.request(method, path, body=body, headers=hdrs)
            r = c.getresponse()
            data = r.read()
            return r.status, dict((k.lower(), v) for k, v in r.getheaders()), data
        finally:
            c.close()

    def json(self, method, path, body=None, ctype=None):
        st, _h, data = self.request(method, path, body, ctype)
        try:
            doc = json.loads(data or b"null")
        except ValueError:
            doc = None
        if st != 200:
            words = doc.get("error") if isinstance(doc, dict) else data[:300].decode("utf-8", "replace").strip()
            raise Refused("%s %s: %d %s" % (method, path, st, words))
        return doc

    def _login(self, user):
        user = user or input("The panel's name: ").strip()
        pw = getpass.getpass("The panel's password for %s: " % user)
        st, h, data = self.request("POST", "/login", urllib.parse.urlencode({"name": user, "password": pw}).encode(),
                                   "application/x-www-form-urlencoded", token=False)
        if st != 200 or "set-cookie" not in h:
            raise Refused("the login was refused: %s" % data[:200].decode("utf-8", "replace").strip())
        self.cookie = h["set-cookie"].split(";", 1)[0]
        st, _h, page = self.request("GET", "/", token=False)
        m = re.search(rb"var TOK = '([0-9a-f]{16,128})'", page)
        if st != 200 or not m:
            raise Refused("the panel page gave no token after the login (%d)" % st)
        self.token = m.group(1).decode()


def _multipart(field, name, data):
    b = "ffx%s" % hashlib.sha256(data[:4096] + str(time.time()).encode()).hexdigest()[:24]
    body = (("--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\n"
             "Content-Type: application/octet-stream\r\n\r\n" % (b, field, name)).encode() + data +
            ("\r\n--%s--\r\n" % b).encode())
    return body, "multipart/form-data; boundary=%s" % b


def cmd_install(a):
    data = open(a.file, "rb").read()
    mc = Machine(a.machine, a.user)
    body, ctype = _multipart("file", os.path.basename(a.file), data)
    j = mc.json("POST", "/ext/upload", body, ctype)
    pkg = j.get("package") or {}
    print("%s %s, by %s: %s" % (pkg.get("id"), pkg.get("version"), pkg.get("author"), j.get("tier")))
    if j.get("update"):
        print("  an update of %s%s" % (j.get("from_version"), " (older than the installed one)" if j.get("downgrade") else ""))
    for c in pkg.get("capabilities") or []:
        tag = " (needs your grant)" if c in (j.get("needs_grant") or []) else ""
        tag += " (new)" if c in (j.get("new_capabilities") or []) and j.get("update") else ""
        print("  may: %s%s" % (c, tag))
    grants = list(a.grant or [])
    for g in grants:
        if g not in (j.get("needs_grant") or []):
            mc.request("POST", "/ext/upload/discard")
            raise Refused("%s is not something this package needs a grant for" % g)
    form = {"grants": ",".join(grants)}
    consent = j.get("consent")
    if consent == "typed":
        form["phrase"] = input("A community package: type I UNDERSTAND to install it: ")
    elif consent == "button":
        input("An unverified package: hold the machine's button, and press Enter while you hold it. ")
    try:
        j = mc.json("POST", "/ext/install", urllib.parse.urlencode(form).encode(), "application/x-www-form-urlencoded")
    except Refused:
        mc.request("POST", "/ext/upload/discard")
        raise
    print("installed: %s" % pkg.get("id"))
    return 0


def cmd_logs(a):
    mc = Machine(a.machine, a.user)
    frm = -1
    while True:
        q = {"name": "forgeext", "lines": "400"}
        if frm >= 0:
            q["from"] = str(frm)
        j = mc.json("GET", "/logs/tail?" + urllib.parse.urlencode(q))
        for line in (j.get("text") or "").splitlines():
            if not a.id or a.id in line:
                print(line)
        frm = j.get("offset", -1)               # where the next read starts, as the panel follows it
        if not a.follow:
            return 0
        time.sleep(2)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="ffx", description="ForgeFIRM extension packages: make, check, pack, install.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("new", help="a new package from the template")
    p.add_argument("dir")
    p.add_argument("--id", required=True)
    p.add_argument("--runtime", required=True, choices=("ui", "python", "shell", "native", "data"))
    p.add_argument("--name")
    p.add_argument("--key", help="the public key that signs the package (NAME.pub from ffx keygen), kept as key.pub")
    p.set_defaults(fn=cmd_new)
    p = sub.add_parser("lint", help="judge a package as the machine does")
    p.add_argument("dir")
    p.set_defaults(fn=cmd_lint)
    p = sub.add_parser("pack", help="lint, then build the .ffx, signed with --key")
    p.add_argument("dir")
    p.add_argument("--key", help="the private key (NAME.priv from ffx keygen); its NAME.pub must be beside it")
    p.add_argument("--out")
    p.set_defaults(fn=cmd_pack)
    p = sub.add_parser("index", help="OpenGlow's catalog: a version's record, and the signed index")
    isub = p.add_subparsers(dest="icmd", required=True)
    q = isub.add_parser("record", help="one listed version, from its signed archive")
    q.add_argument("file", help="the package's .ffx")
    q.add_argument("--url", required=True, help="the https:// address a machine fetches it from")
    q.add_argument("--key", help="its author's public key (NAME.pub); none for an id in OpenGlow's namespace")
    q.add_argument("--official-key", help="the OpenGlow extension key's public half, for OpenGlow's own packages")
    q.add_argument("--out", help="the record's file (packages/<id>/<version>.json); standard output without it")
    q.set_defaults(fn=cmd_index_record)
    q = isub.add_parser("build", help="the signed index of a catalog directory")
    q.add_argument("catalog", help="the catalog: packages/<id>/key.pub, <version>.json, withdrawn.json")
    q.add_argument("--version", required=True, help="the index's own version, YYYY.MMDD.N: a machine never keeps "
                   "one older than the index it has")
    q.add_argument("--key", help="the OpenGlow extension key's private half: no machine keeps an index signed otherwise")
    q.add_argument("--out", required=True)
    q.set_defaults(fn=cmd_index_build)
    p = sub.add_parser("keygen", help="an Ed25519 key pair for signing")
    p.add_argument("name")
    p.set_defaults(fn=cmd_keygen)
    p = sub.add_parser("install", help="install a .ffx on a machine")
    p.add_argument("file")
    p.add_argument("--machine", required=True, help="the machine's address[:port]")
    p.add_argument("--user")
    p.add_argument("--grant", action="append", help="a capability that needs your grant (repeat)")
    p.set_defaults(fn=cmd_install)
    p = sub.add_parser("logs", help="the extension host's log on a machine")
    p.add_argument("--machine", required=True)
    p.add_argument("--user")
    p.add_argument("--id", help="a package's lines alone")
    p.add_argument("--follow", action="store_true")
    p.set_defaults(fn=cmd_logs)
    a = ap.parse_args(argv)
    try:
        return a.fn(a)
    except Refused as e:
        print("refused: %s" % e, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
